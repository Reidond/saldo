{
  "name": "@saldo/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp pack && cf build",
    "pack": "vp pack",
    "deploy:check": "cf deploy --dry-run --prebuilt --mode production --containers-rollout none",
    "bootstrap": "tsx bootstrap.ts",
    "types": "cf workers types",
    "test": "vp test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@cloudflare/containers": "catalog:",
    "@saldo/domain": "workspace:*",
    "jose": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "cf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
