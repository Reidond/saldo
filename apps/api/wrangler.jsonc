{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saldo",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": { "enabled": false },
  // Set IDs only after creating resources in your own Cloudflare account.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saldo",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "saldo-private" }],
  "vars": { "APP_ORIGIN": "http://localhost:8787" },
}
