{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "saldo-ai-bridge",
  "main": "cloudflare.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "containers": [
    {
      "class_name": "SaldoAI",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "max_instances": 1,
      "instance_type": "lite",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "SALDO_AI", "class_name": "SaldoAI" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SaldoAI"] }],
}
