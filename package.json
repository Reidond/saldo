{
  "name": "saldo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter @saldo/web dev",
    "dev:api": "vp run --filter @saldo/api dev",
    "build": "vp run -r build",
    "preview": "vp run --filter @saldo/web preview",
    "test": "vp test",
    "lint": "vp lint",
    "format": "vp fmt",
    "typecheck": "vp run -r typecheck && tsc --noEmit",
    "check": "vp check && vp run typecheck && vp test && vp run build",
    "db:migrate": "vp run --filter @saldo/api db:migrate",
    "deploy:check": "vp run -r deploy:check"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.9.1"
}
